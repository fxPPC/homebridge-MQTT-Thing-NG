    "test": "jest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "jsonpath-plus": "^10.1.0",
    "mqtt": "^5.3.5",
    "vm2": "^3.9.16",
    "fakegato-history": "^0.6.7"
  },
  "devDependencies": {
    "eslint": "^9.25.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "eslint-plugin-security": "^1.7.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "mqtt-connection": "^6.0.1",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  }
