{
  "name": "homebridge-mqttthing-ng",
  "displayName": "MQTT Thing NG (v2)",
  "version": "2.0.0-beta.1",
  "description": "Next-generation rewrite of mqttthing for Homebridge v2 – expose MQTT topics as full-featured HomeKit accessories.",
  "author": "fxPPC, Rumours TheServer & Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxPPC/homebridge-mqttthing-ng.git"
  },
  "bugs": {
    "url": "https://github.com/fxPPC/homebridge-mqttthing-ng/issues"
  },
  "homepage": "https://github.com/fxPPC/homebridge-mqttthing-ng#readme",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "mqtt",
    "homekit"
  ],
  "engines": {
    "node": ">=18.0.0 <23.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "watch": "npm run build -- -w & nodemon -q test/hb.js",
